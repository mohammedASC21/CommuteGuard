{
  "name": "commuteguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "diagnose": "node --env-file-if-exists=.env.local --import tsx scripts/diagnose.ts",
    "env:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-env.ts",
    "commute:check": "node --env-file-if-exists=.env.local --import tsx scripts/commute.ts",
    "commute:observe": "node --env-file-if-exists=.env.local --import tsx scripts/commute.ts --observe",
    "dev": "next dev --webpack",
    "start": "next start",
    "secret:scan": "node --env-file-if-exists=.env.local --import tsx scripts/scan-secrets.ts",
    "history:status": "node --env-file-if-exists=.env.local --import tsx scripts/history-status.ts",
    "migration:validate": "node --import tsx --test tests/persistent-history.test.ts tests/collector.test.ts",
    "history:prune": "node --env-file-if-exists=.env.local --import tsx scripts/history-prune.ts",
    "history:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/history-smoke.ts",
    "collector:status": "node --env-file-if-exists=.env.local --import tsx scripts/collector-status.ts",
    "collector:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/collector-smoke.ts",
    "collector:test": "node --import tsx --test tests/collector.test.ts",
    "deployment:check": "node --env-file-if-exists=.env.local --import tsx scripts/deployment-check.ts",
    "deployment:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/deployment-smoke.ts",
    "morning:report": "node --env-file-if-exists=.env.local --import tsx scripts/morning-report.ts",
    "local:scheduler": "node --env-file-if-exists=.env.local --import tsx scripts/local-scheduler.ts",
    "notification:status": "node --env-file-if-exists=.env.local --import tsx scripts/notification-status.ts",
    "vapid:generate": "node --import tsx scripts/generate-vapid.ts",
    "demo:scheduler": "node --env-file-if-exists=.env.local --import tsx scripts/demo-scheduler.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  }
}

# Put real values in ignored .env.local, never in this example.
# Server-only MTA Bus Time developer key. Never prefix with NEXT_PUBLIC_.
MTA_BUS_TIME_API_KEY=
# Actual numeric boarding stop code; see README for the confirmed commute.
# Empty means VehicleMonitoring in the single-request diagnostic.
MTA_STOP_ID=
# Web app and commute commands require verified stop 103617 / direction 1.
# GTFS direction 0 or 1 for standalone diagnostics.
MTA_DIRECTION_ID=

# Server-only database access, never NEXT_PUBLIC_.
# Prefer a Supabase sb_secret_ key; legacy service_role JWT is accepted as an alternative.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# supabase for shared history; memory is an explicit development-only fallback.
# Empty selects Supabase only when URL + a privileged key are configured; otherwise fails closed.
COMMUTEGUARD_HISTORY_BACKEND=
# Optional row retention in seconds (default 86400; 600..604800). Evidence window stays 600.
COMMUTEGUARD_HISTORY_RETENTION_SECONDS=

# Dedicated server-only scheduler authentication (32+ random characters).
COMMUTEGUARD_CRON_SECRET=
# Central server-side engineering schedule; production SQL envelope must cover changes.
COMMUTE_TIMEZONE=America/New_York
COMMUTE_DAYS=MONDAY,WEDNESDAY
COMMUTE_DEPARTURE_TIME=10:30
COMMUTE_COLLECTION_START_MINUTES_BEFORE=7
COMMUTE_COLLECTION_INTERVAL_SECONDS=30

# Stable deployed HTTPS origin, no path/query/credentials. Administrative tools only.
# Leave empty until deployed; never use localhost or a temporary preview origin.
COMMUTEGUARD_PRODUCTION_URL=

# Local Web Push: only the PUBLIC key may enter browser JavaScript.
# Generate with pnpm vapid:generate; privately copy entries into .env.local.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
